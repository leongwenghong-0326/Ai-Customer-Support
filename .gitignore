# NovaServe AI - Git Ignore Rule Set

# Database & Environment Configuration (Credentials & Secrets)
config/db_custom.php
config/installed.lock
.env
*.env.local

# User File Uploads (Ignore all user files except directory structure & .htaccess)
uploads/*
!uploads/.htaccess
!uploads/.gitkeep

# Operating System & IDE Artifacts
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Logs & Temporary Files
*.log
scratch/
tmp/
temp/
